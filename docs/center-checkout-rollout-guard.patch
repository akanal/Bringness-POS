+import {deliverySandboxConfig} from './delivery-sandbox.js';
+import {mollieConnectConfiguration} from './center-mollie-connect.js';
+
 export function molliePaymentMode(env=process.env){
  const mode=env.CENTER_MOLLIE_MODE||'test';
  if(!['test','live'].includes(mode))throw Error('INVALID_MOLLIE_MODE');
@@ -11,3 +14,22 @@ export function molliePaymentReadUrl(path,mode){
  else url.searchParams.delete('testmode');
  return url;
 }
+
+export function assertCenterCheckoutConfiguration(env=process.env){
+ if(env.CENTER_CHECKOUT_ENABLED!=='true')return;
+ const sandbox=deliverySandboxConfig(env);
+ const mode=molliePaymentMode(env);
+ if(sandbox ? mode!=='test' : mode!=='live')throw Error('CENTER_CHECKOUT_MODE_MISMATCH');
+
+ let origin;
+ try{origin=new URL(env.CENTER_PAYMENT_ORIGIN);}catch{throw Error('CENTER_CHECKOUT_ORIGIN_INVALID');}
+ if(origin.protocol!=='https:'||origin.href!==origin.origin+'/'||
+    (sandbox ? origin.origin!==sandbox.origin : /^sandbox[-.]/i.test(origin.hostname))){
+  throw Error('CENTER_CHECKOUT_ORIGIN_INVALID');
+ }
+ const connect=mollieConnectConfiguration(env);
+ if(connect?.redirectUri!==origin.origin+'/api/v1/centers/mollie/callback'||
+    !env.CENTER_MOLLIE_CLIENT_SECRET?.trim()||!(/^[a-f0-9]{64}$/i.test(env.CENTER_MOLLIE_TOKEN_KEY||''))){
+  throw Error('CENTER_CHECKOUT_CONNECT_INCOMPLETE');
+ }
+}

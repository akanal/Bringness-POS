 test('OAuth payment creation defaults to test and requires explicit live mode',()=>{
  assert.equal(molliePaymentMode({}),'test');
  assert.equal(molliePaymentMode({CENTER_MOLLIE_MODE:'test'}),'test');
@@ -20,3 +20,30 @@ test('payment mode URL cannot redirect merchant tokens to another host',()=>{
  assert.throws(()=>molliePaymentReadUrl('/v2/organizations/me','test'),/INVALID_PAYMENT_URL/);
  assert.throws(()=>molliePaymentReadUrl('/v2/payments','unknown'),/INVALID_MOLLIE_MODE/);
 });
+
+test('enabled checkout needs an explicit production mode or isolated sandbox',()=>{
+ const env={
+  CENTER_CHECKOUT_ENABLED:'true',CENTER_MOLLIE_MODE:'live',
+  CENTER_PAYMENT_ORIGIN:'https://pos.example.test',
+  CENTER_MOLLIE_REDIRECT_URI:'https://pos.example.test/api/v1/centers/mollie/callback',
+  CENTER_MOLLIE_CLIENT_ID:'app_example',CENTER_MOLLIE_CLIENT_SECRET:'fixture',
+  CENTER_MOLLIE_TOKEN_KEY:'a'.repeat(64)
+ };
+ assert.doesNotThrow(()=>assertCenterCheckoutConfiguration({}));
+ assert.doesNotThrow(()=>assertCenterCheckoutConfiguration(env));
+ assert.throws(()=>assertCenterCheckoutConfiguration({...env,CENTER_MOLLIE_MODE:undefined}),/MODE_MISMATCH/);
+ assert.throws(()=>assertCenterCheckoutConfiguration({...env,CENTER_MOLLIE_MODE:'test'}),/MODE_MISMATCH/);
+ assert.throws(()=>assertCenterCheckoutConfiguration({...env,CENTER_PAYMENT_ORIGIN:'https://sandbox-pos.example.test'}),/ORIGIN_INVALID/);
+ assert.throws(()=>assertCenterCheckoutConfiguration({...env,CENTER_MOLLIE_CLIENT_SECRET:''}),/CONNECT_INCOMPLETE/);
+ assert.throws(()=>assertCenterCheckoutConfiguration({...env,CENTER_MOLLIE_TOKEN_KEY:'invalid'}),/CONNECT_INCOMPLETE/);
+ assert.throws(()=>assertCenterCheckoutConfiguration({...env,CENTER_MOLLIE_REDIRECT_URI:'https://other.example.test/api/v1/centers/mollie/callback'}),/CONNECT_INCOMPLETE/);
+ const origin='https://sandbox-pos.example.test';
+ const sandbox={...env,CENTER_MOLLIE_MODE:'test',CENTER_PAYMENT_ORIGIN:origin,
+  CENTER_MOLLIE_REDIRECT_URI:origin+'/api/v1/centers/mollie/callback',
+  BRINGNESS_DELIVERY_SANDBOX:'true',BRINGNESS_DELIVERY_SANDBOX_ORIGIN:origin,
+  BRINGNESS_DELIVERY_SANDBOX_RESTAURANT_ID:'00000000-0000-0000-0000-000000000001',
+  DATABASE_URL:'postgres://example.invalid/bringness_delivery_sandbox'};
+ assert.doesNotThrow(()=>assertCenterCheckoutConfiguration(sandbox));
+ assert.throws(()=>assertCenterCheckoutConfiguration({...sandbox,CENTER_PAYMENT_ORIGIN:env.CENTER_PAYMENT_ORIGIN}),/ORIGIN_INVALID/);
+ assert.throws(()=>assertCenterCheckoutConfiguration({...sandbox,CENTER_MOLLIE_MODE:'live'}),/INVALID_DELIVERY_SANDBOX_CONFIGURATION/);
+});

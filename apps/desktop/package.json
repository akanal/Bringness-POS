{
  "name": "bringness-pos-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bringness POS Windows Desktop Client",
  "main": "main.cjs",
  "scripts": {
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.bringness.pos",
    "productName": "Bringness POS",
    "files": [
      "main.cjs"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "Bringness",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bringness POS"
    },
    "artifactName": "Bringness-POS-Setup-${version}.${ext}"
  }
}

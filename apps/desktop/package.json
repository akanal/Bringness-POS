{
  "name": "bringness-pos-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Bringness POS Windows Desktop Client",
  "main": "main.cjs",
  "scripts": {
    "build": "npm run prepare:offline && electron-builder --win nsis",
    "prepare:offline": "node prepare-offline.cjs"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "de.bringness.pos",
    "productName": "Bringness POS",
    "files": [
      "main.cjs",
      "offline-ledger.mjs",
      "offline-runtime.cjs",
      "offline-preload.cjs",
      "offline.html",
      "offline-ui.js",
      "offline-sale-core.mjs"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": "Bringness"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bringness POS"
    },
    "artifactName": "Bringness-POS-Setup-${version}.${ext}"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}

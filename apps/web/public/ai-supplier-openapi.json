      "post": {
        "operationId": "importSupplierProducts",
        "summary": "Bis 100 Produkte atomar anlegen oder aktualisieren",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requestId",
                  "products"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "products": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/ProductInput"
                    }
                  }
                }
              }
            }
          }
        },

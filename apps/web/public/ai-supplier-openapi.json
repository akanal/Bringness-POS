  "components": {
    "securitySchemes": {
      "SupplierKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ProductInput": {
        "type": "object",
        "required": [
          "externalCode",
          "name",
          "unit",
          "packQuantity",
          "priceCents"
        ],
        "properties": {
          "externalCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "unit": {
            "type": "string",
            "enum": [
              "kg",
              "l",
              "piece"
            ]
          },
          "packQuantity": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 1000000,
            "multipleOf": 0.001,
            "description": "Bei piece eine ganze Zahl."
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Nettopreis je Packung in Cent."
          },
          "minimumPacks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "available": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "external_code": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "pack_quantity": {
            "type": "string",
            "description": "Dezimalmenge als PostgreSQL-Zeichenfolge."
          },
          "price_cents": {
            "type": "string",
            "description": "Netto-Cent als PostgreSQL-bigint-Zeichenfolge."
          },
          "minimum_packs": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "external_code": {
            "type": "string",
            "nullable": true
          },
          "product_name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "pack_quantity": {
            "type": "string"
          },
          "packs": {
            "type": "integer"
          },
          "net_cents": {
            "type": "string"
          },
          "commission_bps": {
            "type": "integer"
          },
          "commission_cents": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "accepted",
              "received",
              "cancelled"
            ]
          },
          "delivery_date": {
            "type": "string",
            "format": "date"
          },
          "delivery_address": {
            "type": "string"
          },
          "buyer_email": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }

    "/api/ai/v1/kitchen-orders": {
      "post": {
        "operationId": "updateKitchenInventory",
        "summary": "Zutaten reservieren, verbrauchen, Reservierung stornieren oder unbenutzte Zutaten zurückbuchen",
        "description": "Eigener Auftragsnamensraum pro Standort und Verbindung. Unter Kassen & API vor erster Buchung den Modus Reservierung & Zubereitung wählen. accept benötigt items; cancel und return benötigen reason; return außerdem confirmed=true und lines. locationId wird ausschließlich aus dem API-Schlüssel aufgelöst. Nach Zubereitungsbeginn gibt cancel keine Zutaten zurück. Rückbuchung nur bis zum verbleibenden ursprünglichen Verbrauch. Der API-Schlüssel ist ein privilegierter Lagerzugang und darf niemals Gästen zugänglich sein.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KitchenAction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aktion bestätigt oder identische Wiederholung; keine Doppelbuchung."
          },
          "400": {
            "description": "Ungültige Eingabe; keine Teilbuchung."
          },
          "401": {
            "description": "Ungültiger API-Schlüssel."
          },
          "403": {
            "description": "Verbindung nicht aktiv oder nicht im Modus lifecycle."
          },
          "409": {
            "description": "Konflikt, Fehlbestand oder unzulässiger Status; keine Teilbuchung."
          },
          "429": {
            "description": "Importlimit erreicht."
          },
          "500": {
            "description": "Serverfehler; Aktion mit derselben Kennung wiederholen."
          }
        }
      }
    },
    "/api/ai/v1/availability": {
      "get": {
        "operationId": "getRecipeAvailability",
        "summary": "Bestellbarkeit der Gerichte am Schlüsselstandort",
        "description": "available berücksichtigt aktives Rezept, manuelle Ausverkauft-Sperre und freie Zutaten nach Reservierungen. Angeschlossene Kassen müssen available=false in ihrem Bestellkanal durchsetzen. Ohne das ist eine externe Speisekarte nicht automatisch gesperrt.",
        "responses": {
          "200": {
            "description": "Gerichte mit Artikelcode, verfügbarer Bestellbarkeit und Ausverkauft-Sperre."
          },
          "401": {
            "description": "Ungültiger Schlüssel."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ConnectorKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Standortgebundener API-Schlüssel; kein AI-Login-Token."
      }
    },
    "schemas": {
      "SaleItem": {
        "type": "object",
        "required": [

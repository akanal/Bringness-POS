{
  "name": "bringness-delivery-sandbox",
  "services": {
    "database": {
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_DB": "bringness_delivery_sandbox",
        "POSTGRES_USER": "delivery_sandbox",
        "POSTGRES_PASSWORD": "${DELIVERY_SANDBOX_DATABASE_PASSWORD:?required}"
      },
      "healthcheck": {
        "test": ["CMD", "pg_isready", "-U", "delivery_sandbox", "-d", "bringness_delivery_sandbox"],
        "interval": "3s",
        "timeout": "3s",
        "retries": 30
      },
      "volumes": ["sandbox_data:/var/lib/postgresql/data"],
      "networks": ["database"]
    },
    "app": {
      "build": {"context": "..", "dockerfile": "ops/isolated-preview.Dockerfile"},
      "command": ["node", "server/start.js"],
      "depends_on": {"database": {"condition": "service_healthy"}},
      "environment": {
        "APP_MODE": "pos",
        "NODE_ENV": "development",
        "PORT": "3000",
        "DATABASE_URL": "postgresql://delivery_sandbox:${DELIVERY_SANDBOX_DATABASE_PASSWORD:?required}@database:5432/bringness_delivery_sandbox",
        "PUBLIC_BASE_URL": "${DELIVERY_SANDBOX_ORIGIN:?required}",
        "PUBLIC_URL": "${DELIVERY_SANDBOX_ORIGIN:?required}",
        "BRINGNESS_DELIVERY_SANDBOX": "true",
        "BRINGNESS_DELIVERY_SANDBOX_ORIGIN": "${DELIVERY_SANDBOX_ORIGIN:?required}",
        "BRINGNESS_DELIVERY_SANDBOX_RESTAURANT_ID": "${DELIVERY_SANDBOX_RESTAURANT_ID:?required}",
        "BRINGNESS_DELIVERY_LIVE_CHECKOUT": "false",
        "CENTER_MOLLIE_MODE": "test",
        "BRINGNESS_DELIVERY_SANDBOX_REFUNDS": "${DELIVERY_SANDBOX_MOLLIE_REFUNDS:-false}",
        "CENTER_MOLLIE_CLIENT_ID": "${DELIVERY_SANDBOX_MOLLIE_CLIENT_ID:?required}",
        "CENTER_MOLLIE_CLIENT_SECRET": "${DELIVERY_SANDBOX_MOLLIE_CLIENT_SECRET:?required}",
        "CENTER_MOLLIE_TOKEN_KEY": "${DELIVERY_SANDBOX_MOLLIE_TOKEN_KEY:?required}",
        "CENTER_MOLLIE_REDIRECT_URI": "${DELIVERY_SANDBOX_ORIGIN:?required}/api/v1/centers/mollie/callback",
        "PASSWORD_PEPPER": "${DELIVERY_SANDBOX_PASSWORD_PEPPER:?required}"
      },
      "healthcheck": {
        "test": ["CMD", "node", "-e", "const host=new URL(process.env.BRINGNESS_DELIVERY_SANDBOX_ORIGIN).host; require('node:http').get({host:'127.0.0.1',port:3000,path:'/health',headers:{host}},res=>{res.resume();process.exitCode=res.statusCode===200?0:1;}).on('error',()=>{process.exitCode=1;});"],
        "interval": "5s",
        "timeout": "3s",
        "retries": 30,
        "start_period": "15s"
      },
      "ports": ["127.0.0.1:3017:3000"],
      "networks": ["database", "outbound"]
    }
  },
  "volumes": {"sandbox_data": {}},
  "networks": {"database": {"internal": true}, "outbound": {}}
}
